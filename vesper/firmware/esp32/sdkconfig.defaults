# ── VESPER ESP32 QEMU defaults ────────────────────────────────────────────────
# Tuned for running inside Espressif QEMU (qemu-system-xtensa -M esp32)

# Partition table — single factory app + NVS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size (QEMU default 4 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=y

# WiFi — use open_eth virtual NIC in QEMU
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_MODE_STA=y

# LWIP — enable DHCP client
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y
CONFIG_LWIP_IP_REASSEMBLY=y

# MQTT — built-in ESP-MQTT used by SmartThings SDK
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y

# TLS (mbedtls) — SmartThings requires TLS 1.2+
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=16384
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# SmartThings Device SDK
CONFIG_STDK_IOT_CORE=y
CONFIG_STDK_IOT_CORE_BSP_SUPPORT_ESP32=y
CONFIG_STDK_IOT_CORE_OS_SUPPORT_FREERTOS=y
CONFIG_STDK_IOT_CORE_USE_MBEDTLS=y
CONFIG_STDK_IOT_CORE_CRYPTO_SUPPORT_ED25519=y
CONFIG_STDK_IOT_CORE_SECURITY_BACKEND_SOFTWARE=y
CONFIG_STDK_IOT_CORE_EASYSETUP_BLE=y
CONFIG_STDK_IOT_CORE_LOG_LEVEL_INFO=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Watchdog — relax for QEMU
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_INT_WDT=n
