# Optional local LLM service; the core demo needs no credentials.
OPENWEBUI_URL=http://localhost:1234/v1/chat/completions
OPENWEBUI_API_KEY=
VESPER_LLM_MODEL=qwen2.5-7b-instruct

# Optional SmartThings integrations: choose PAT or Schema integration.
SMARTTHINGS_TOKEN=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
VESPER_SCHEMA_HOST=127.0.0.1
VESPER_OAUTH_CLIENT_ID=
VESPER_OAUTH_CLIENT_SECRET=

# Optional Home Assistant / Matter configuration.
# See docs/connectors.md for the configuration fields used by each path.
HA_TOKEN=
NGROK_AUTHTOKEN=
