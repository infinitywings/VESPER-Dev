# VESPER Virtual IoT Device Container
# Runs ARM Cortex-M3 firmware in QEMU inside a Docker container
# Each container = one virtual IoT device
# Supports per-device firmware types (motion_sensor, smart_light, etc.)

FROM ubuntu:22.04

# Install QEMU for ARM emulation + socat for serial port forwarding
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        qemu-system-arm \
        socat \
        && rm -rf /var/lib/apt/lists/*

# Create firmware directory
WORKDIR /firmware

# Copy the generic (legacy) firmware as default
COPY vesper/firmware/samples/sensor_firmware.elf /firmware/sensor_firmware.elf

# Copy per-device-type firmware variants
COPY vesper/firmware/samples/device_types/motion_sensor.elf /firmware/motion_sensor.elf
COPY vesper/firmware/samples/device_types/temperature_sensor.elf /firmware/temperature_sensor.elf
COPY vesper/firmware/samples/device_types/smart_light.elf /firmware/smart_light.elf
COPY vesper/firmware/samples/device_types/humidity_sensor.elf /firmware/humidity_sensor.elf
COPY vesper/firmware/samples/device_types/door_sensor.elf /firmware/door_sensor.elf
COPY vesper/firmware/samples/device_types/smart_plug.elf /firmware/smart_plug.elf

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose TCP port for serial communication (host <-> firmware)
EXPOSE 5555

# Environment variables
ENV DEVICE_ID="vesper-device"
ENV DEVICE_NAME="Virtual Device"
ENV DEVICE_TYPE="generic"
ENV FIRMWARE_ELF=""
ENV QEMU_MACHINE="lm3s6965evb"
ENV QEMU_CPU="cortex-m3"
ENV SERIAL_PORT="5555"

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s \
    CMD socat -T1 TCP:localhost:${SERIAL_PORT} EXEC:"echo STATUS" 2>/dev/null | grep -q "OK" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
